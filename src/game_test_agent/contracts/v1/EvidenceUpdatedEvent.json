{
  "$defs": {
    "EvidenceUpdatedData": {
      "additionalProperties": false,
      "properties": {
        "evidence_pending": {
          "default": false,
          "title": "Evidence Pending",
          "type": "boolean"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "result_revision": {
          "minimum": 1,
          "title": "Result Revision",
          "type": "integer"
        },
        "run_ref": {
          "$ref": "#/$defs/RunRef"
        }
      },
      "required": [
        "run_ref",
        "result_revision"
      ],
      "title": "EvidenceUpdatedData",
      "type": "object"
    },
    "RunRef": {
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "provider_id": {
          "title": "Provider Id",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "provider_id",
        "project_id",
        "run_id"
      ],
      "title": "RunRef",
      "type": "object"
    }
  },
  "$id": "contract://v1/EvidenceUpdatedEvent",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "causation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Causation Id"
    },
    "correlation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correlation Id"
    },
    "data": {
      "$ref": "#/$defs/EvidenceUpdatedData"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "const": "game_test.evidence.updated",
      "title": "Event Type",
      "type": "string"
    },
    "investigation_depth": {
      "default": 0,
      "maximum": 10,
      "minimum": 0,
      "title": "Investigation Depth",
      "type": "integer"
    },
    "investigation_id": {
      "title": "Investigation Id",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "origin": {
      "enum": [
        "platform",
        "agent"
      ],
      "title": "Origin",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "published_at": {
      "format": "date-time",
      "title": "Published At",
      "type": "string"
    },
    "root_event_id": {
      "title": "Root Event Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "title": "Source",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "source",
    "tenant_id",
    "project_id",
    "occurred_at",
    "published_at",
    "root_event_id",
    "origin",
    "investigation_id",
    "data"
  ],
  "title": "EvidenceUpdatedEvent",
  "type": "object"
}
