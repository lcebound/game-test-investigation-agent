{
  "$defs": {
    "AnomalyData": {
      "additionalProperties": false,
      "properties": {
        "build": {
          "$ref": "#/$defs/BuildRef"
        },
        "environment_fingerprint": {
          "title": "Environment Fingerprint",
          "type": "string"
        },
        "evidence_pending": {
          "default": false,
          "title": "Evidence Pending",
          "type": "boolean"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "execution_source": {
          "enum": [
            "real",
            "simulated"
          ],
          "title": "Execution Source",
          "type": "string"
        },
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "incident_key": {
          "title": "Incident Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "test_failure",
            "crash",
            "performance_regression",
            "memory_growth",
            "infrastructure"
          ],
          "title": "Kind",
          "type": "string"
        },
        "observation": {
          "anyOf": [
            {
              "$ref": "#/$defs/MetricObservation"
            },
            {
              "additionalProperties": true,
              "type": "object"
            }
          ],
          "title": "Observation"
        },
        "requested_policy_profile": {
          "default": "bounded-diagnosis",
          "title": "Requested Policy Profile",
          "type": "string"
        },
        "result_revision": {
          "minimum": 1,
          "title": "Result Revision",
          "type": "integer"
        },
        "run_ref": {
          "$ref": "#/$defs/RunRef"
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "incident_key",
        "kind",
        "severity",
        "run_ref",
        "result_revision",
        "execution_source",
        "build",
        "environment_fingerprint",
        "observation"
      ],
      "title": "AnomalyData",
      "type": "object"
    },
    "BuildRef": {
      "additionalProperties": false,
      "properties": {
        "configuration": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Configuration",
          "type": "object"
        },
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        }
      },
      "required": [
        "id"
      ],
      "title": "BuildRef",
      "type": "object"
    },
    "MetricObservation": {
      "additionalProperties": false,
      "properties": {
        "baseline_run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Run Id"
        },
        "baseline_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Value"
        },
        "comparison_status": {
          "default": "unknown",
          "enum": [
            "comparable",
            "not_comparable",
            "unknown"
          ],
          "title": "Comparison Status",
          "type": "string"
        },
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "sample_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Count"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "window_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window Seconds"
        }
      },
      "required": [
        "metric",
        "value",
        "unit"
      ],
      "title": "MetricObservation",
      "type": "object"
    },
    "RunRef": {
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "provider_id": {
          "title": "Provider Id",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "provider_id",
        "project_id",
        "run_id"
      ],
      "title": "RunRef",
      "type": "object"
    }
  },
  "$id": "contract://v1/AnomalyDetectedEvent",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "causation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Causation Id"
    },
    "correlation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correlation Id"
    },
    "data": {
      "$ref": "#/$defs/AnomalyData"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "const": "game_test.anomaly.detected",
      "title": "Event Type",
      "type": "string"
    },
    "investigation_depth": {
      "default": 0,
      "maximum": 10,
      "minimum": 0,
      "title": "Investigation Depth",
      "type": "integer"
    },
    "investigation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Investigation Id"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "origin": {
      "enum": [
        "platform",
        "agent",
        "user"
      ],
      "title": "Origin",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "published_at": {
      "format": "date-time",
      "title": "Published At",
      "type": "string"
    },
    "root_event_id": {
      "title": "Root Event Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "title": "Source",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "source",
    "tenant_id",
    "project_id",
    "occurred_at",
    "published_at",
    "root_event_id",
    "origin",
    "data"
  ],
  "title": "AnomalyDetectedEvent",
  "type": "object"
}
