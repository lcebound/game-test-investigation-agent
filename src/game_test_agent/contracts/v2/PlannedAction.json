{
  "$defs": {
    "ActionProposal": {
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "title": "Capability Id",
          "type": "string"
        },
        "capability_version": {
          "title": "Capability Version",
          "type": "string"
        },
        "constraints": {
          "additionalProperties": true,
          "title": "Constraints",
          "type": "object"
        },
        "expected_observation": {
          "title": "Expected Observation",
          "type": "string"
        },
        "experiment_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Experiment Id"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "provider_id": {
          "title": "Provider Id",
          "type": "string"
        },
        "provider_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Revision"
        },
        "repeat_index": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repeat Index"
        },
        "target_selector": {
          "$ref": "#/$defs/TargetSelector"
        }
      },
      "required": [
        "capability_id",
        "capability_version",
        "provider_id",
        "parameters",
        "expected_observation"
      ],
      "title": "ActionProposal",
      "type": "object"
    },
    "ActionSpec": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "title": "Action Id",
          "type": "string"
        },
        "build_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/BuildRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "capability_id": {
          "title": "Capability Id",
          "type": "string"
        },
        "capability_version": {
          "title": "Capability Version",
          "type": "string"
        },
        "constraints": {
          "additionalProperties": true,
          "title": "Constraints",
          "type": "object"
        },
        "expected_observation": {
          "title": "Expected Observation",
          "type": "string"
        },
        "experiment_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Experiment Id"
        },
        "idempotency_key": {
          "title": "Idempotency Key",
          "type": "string"
        },
        "investigation_id": {
          "title": "Investigation Id",
          "type": "string"
        },
        "operation_kind": {
          "const": "experiment",
          "default": "experiment",
          "title": "Operation Kind",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "plan_node_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Node Revision"
        },
        "plan_revision": {
          "minimum": 1,
          "title": "Plan Revision",
          "type": "integer"
        },
        "plan_step_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Step Id"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "provider_id": {
          "title": "Provider Id",
          "type": "string"
        },
        "provider_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Revision"
        },
        "repeat_index": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repeat Index"
        },
        "run_sequence": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Sequence"
        },
        "schema_version": {
          "default": "2.0",
          "enum": [
            "1.0",
            "2.0"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "target_selector": {
          "$ref": "#/$defs/TargetSelector"
        },
        "tenant_id": {
          "title": "Tenant Id",
          "type": "string"
        },
        "test_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/TestRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "tenant_id",
        "project_id",
        "investigation_id",
        "action_id",
        "idempotency_key",
        "capability_id",
        "capability_version",
        "provider_id",
        "parameters",
        "expected_observation",
        "plan_revision"
      ],
      "title": "ActionSpec",
      "type": "object"
    },
    "BuildRef": {
      "additionalProperties": false,
      "properties": {
        "configuration": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Configuration",
          "type": "object"
        },
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        }
      },
      "required": [
        "id"
      ],
      "title": "BuildRef",
      "type": "object"
    },
    "TargetSelector": {
      "additionalProperties": false,
      "properties": {
        "environment_fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Environment Fingerprint"
        },
        "resource_pool": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource Pool"
        },
        "target_kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Kind"
        }
      },
      "title": "TargetSelector",
      "type": "object"
    },
    "TestRef": {
      "additionalProperties": false,
      "properties": {
        "test_id": {
          "title": "Test Id",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "test_id"
      ],
      "title": "TestRef",
      "type": "object"
    }
  },
  "$id": "contract://v2/PlannedAction",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "$ref": "#/$defs/ActionSpec"
    },
    "action_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Action Hash",
      "type": "string"
    },
    "attempts": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Attempts",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "decision_id": {
      "title": "Decision Id",
      "type": "string"
    },
    "investigation_id": {
      "title": "Investigation Id",
      "type": "string"
    },
    "model_profile_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Profile Id"
    },
    "model_profile_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Profile Version"
    },
    "normalization_log": {
      "items": {
        "type": "string"
      },
      "title": "Normalization Log",
      "type": "array"
    },
    "plan_revision": {
      "minimum": 1,
      "title": "Plan Revision",
      "type": "integer"
    },
    "planning_id": {
      "title": "Planning Id",
      "type": "string"
    },
    "proposal": {
      "$ref": "#/$defs/ActionProposal"
    },
    "proposal_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Proposal Hash",
      "type": "string"
    },
    "raw_output_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw Output Ref"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "usage": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "string"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Usage",
      "type": "object"
    }
  },
  "required": [
    "planning_id",
    "investigation_id",
    "plan_revision",
    "decision_id",
    "proposal",
    "proposal_hash",
    "action",
    "action_hash"
  ],
  "title": "PlannedAction",
  "type": "object"
}
