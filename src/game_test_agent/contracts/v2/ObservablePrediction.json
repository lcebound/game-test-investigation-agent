{
  "$id": "contract://v2/ObservablePrediction",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A checkable expected observation, not a self-reported probability.",
  "properties": {
    "absolute_tolerance": {
      "default": 0,
      "minimum": 0,
      "title": "Absolute Tolerance",
      "type": "number"
    },
    "capability_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Capability Id"
    },
    "comparator": {
      "enum": [
        "eq",
        "gt",
        "lt",
        "contains"
      ],
      "title": "Comparator",
      "type": "string"
    },
    "minimum_samples": {
      "default": 3,
      "minimum": 3,
      "title": "Minimum Samples",
      "type": "integer"
    },
    "observation_key": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Observation Key",
      "type": "string"
    },
    "unit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unit"
    },
    "value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        }
      ],
      "title": "Value"
    }
  },
  "required": [
    "observation_key",
    "comparator",
    "value"
  ],
  "title": "ObservablePrediction",
  "type": "object"
}
