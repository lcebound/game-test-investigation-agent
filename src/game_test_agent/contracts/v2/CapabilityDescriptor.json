{
  "$id": "contract://v2/CapabilityDescriptor",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "async": {
      "default": true,
      "title": "Async",
      "type": "boolean"
    },
    "availability": {
      "default": "ready",
      "enum": [
        "ready",
        "degraded",
        "unavailable"
      ],
      "title": "Availability",
      "type": "string"
    },
    "capability_id": {
      "title": "Capability Id",
      "type": "string"
    },
    "capability_version": {
      "title": "Capability Version",
      "type": "string"
    },
    "controllable_variables": {
      "items": {
        "type": "string"
      },
      "title": "Controllable Variables",
      "type": "array"
    },
    "cost_category": {
      "default": "execution",
      "enum": [
        "external_read",
        "execution",
        "analysis"
      ],
      "title": "Cost Category",
      "type": "string"
    },
    "creates_run": {
      "default": true,
      "title": "Creates Run",
      "type": "boolean"
    },
    "effects": {
      "items": {
        "type": "string"
      },
      "title": "Effects",
      "type": "array"
    },
    "estimated_cost": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Estimated Cost",
      "type": "object"
    },
    "evidence_types": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Types",
      "type": "array"
    },
    "execution_owner": {
      "title": "Execution Owner",
      "type": "string"
    },
    "idempotency": {
      "default": "required",
      "enum": [
        "required",
        "supported",
        "none"
      ],
      "title": "Idempotency",
      "type": "string"
    },
    "input_schema": {
      "additionalProperties": true,
      "title": "Input Schema",
      "type": "object"
    },
    "operation_kind": {
      "default": "experiment",
      "enum": [
        "query_run",
        "retrieve_evidence",
        "experiment",
        "analyze"
      ],
      "title": "Operation Kind",
      "type": "string"
    },
    "output_schema": {
      "additionalProperties": true,
      "title": "Output Schema",
      "type": "object"
    },
    "preconditions": {
      "items": {
        "type": "string"
      },
      "title": "Preconditions",
      "type": "array"
    },
    "project_ids": {
      "items": {
        "type": "string"
      },
      "title": "Project Ids",
      "type": "array"
    },
    "provider_id": {
      "title": "Provider Id",
      "type": "string"
    },
    "provider_revision": {
      "title": "Provider Revision",
      "type": "string"
    },
    "required_scopes": {
      "items": {
        "type": "string"
      },
      "title": "Required Scopes",
      "type": "array"
    },
    "requires_existing_run": {
      "default": false,
      "title": "Requires Existing Run",
      "type": "boolean"
    },
    "resource_domain": {
      "title": "Resource Domain",
      "type": "string"
    },
    "resource_mutation": {
      "default": "bounded",
      "enum": [
        "none",
        "bounded",
        "high_impact"
      ],
      "title": "Resource Mutation",
      "type": "string"
    },
    "risk_level": {
      "enum": [
        "read_only",
        "bounded_execution",
        "high_impact"
      ],
      "title": "Risk Level",
      "type": "string"
    },
    "schema_version": {
      "default": "2.0",
      "enum": [
        "1.0",
        "2.0"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "supported_engines": {
      "items": {
        "type": "string"
      },
      "title": "Supported Engines",
      "type": "array"
    },
    "supports_action_lookup": {
      "default": true,
      "title": "Supports Action Lookup",
      "type": "boolean"
    },
    "target_kinds": {
      "items": {
        "type": "string"
      },
      "title": "Target Kinds",
      "type": "array"
    },
    "tool_name": {
      "title": "Tool Name",
      "type": "string"
    }
  },
  "required": [
    "capability_id",
    "capability_version",
    "provider_id",
    "provider_revision",
    "tool_name",
    "project_ids",
    "input_schema",
    "risk_level",
    "execution_owner",
    "resource_domain"
  ],
  "title": "CapabilityDescriptor",
  "type": "object"
}
