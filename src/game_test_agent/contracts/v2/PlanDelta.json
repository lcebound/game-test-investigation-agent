{
  "$defs": {
    "PlanFailureHandling": {
      "additionalProperties": false,
      "properties": {
        "fallback_step_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fallback Step Id"
        },
        "max_attempts": {
          "default": 1,
          "maximum": 20,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "strategy": {
          "default": "replan",
          "enum": [
            "stop",
            "skip",
            "retry",
            "replan",
            "request_input"
          ],
          "title": "Strategy",
          "type": "string"
        }
      },
      "title": "PlanFailureHandling",
      "type": "object"
    },
    "PlanInputBinding": {
      "additionalProperties": false,
      "properties": {
        "expected_type": {
          "minLength": 1,
          "title": "Expected Type",
          "type": "string"
        },
        "input_name": {
          "minLength": 1,
          "title": "Input Name",
          "type": "string"
        },
        "source_output": {
          "minLength": 1,
          "title": "Source Output",
          "type": "string"
        },
        "source_step_id": {
          "minLength": 1,
          "title": "Source Step Id",
          "type": "string"
        }
      },
      "required": [
        "input_name",
        "source_step_id",
        "source_output",
        "expected_type"
      ],
      "title": "PlanInputBinding",
      "type": "object"
    },
    "PlanOutputContract": {
      "additionalProperties": false,
      "properties": {
        "output_name": {
          "minLength": 1,
          "title": "Output Name",
          "type": "string"
        },
        "output_type": {
          "minLength": 1,
          "title": "Output Type",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "output_name",
        "output_type"
      ],
      "title": "PlanOutputContract",
      "type": "object"
    },
    "PlanResourceRequirement": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Amount",
          "type": "number"
        },
        "exclusive": {
          "default": true,
          "title": "Exclusive",
          "type": "boolean"
        },
        "resource_domain": {
          "minLength": 1,
          "title": "Resource Domain",
          "type": "string"
        },
        "unit": {
          "default": "slots",
          "enum": [
            "slots",
            "device_minutes",
            "bytes"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "resource_domain"
      ],
      "title": "PlanResourceRequirement",
      "type": "object"
    },
    "PlanStep": {
      "additionalProperties": false,
      "properties": {
        "action_type": {
          "enum": [
            "query",
            "experiment",
            "analyze",
            "evaluate",
            "report",
            "request_input"
          ],
          "title": "Action Type",
          "type": "string"
        },
        "capability_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capability Id"
        },
        "capability_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capability Version"
        },
        "completion_conditions": {
          "items": {
            "type": "string"
          },
          "title": "Completion Conditions",
          "type": "array"
        },
        "cost_limit_device_minutes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Limit Device Minutes"
        },
        "dependencies": {
          "items": {
            "type": "string"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "estimated_device_minutes": {
          "default": 0,
          "minimum": 0,
          "title": "Estimated Device Minutes",
          "type": "number"
        },
        "expected_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Expected Evidence",
          "type": "array"
        },
        "failure_handling": {
          "$ref": "#/$defs/PlanFailureHandling"
        },
        "input_bindings": {
          "items": {
            "$ref": "#/$defs/PlanInputBinding"
          },
          "title": "Input Bindings",
          "type": "array"
        },
        "objective_id": {
          "title": "Objective Id",
          "type": "string"
        },
        "outputs": {
          "items": {
            "$ref": "#/$defs/PlanOutputContract"
          },
          "title": "Outputs",
          "type": "array"
        },
        "preconditions": {
          "items": {
            "type": "string"
          },
          "title": "Preconditions",
          "type": "array"
        },
        "provider_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Id"
        },
        "required_inputs": {
          "items": {
            "type": "string"
          },
          "title": "Required Inputs",
          "type": "array"
        },
        "resource_requirements": {
          "items": {
            "$ref": "#/$defs/PlanResourceRequirement"
          },
          "title": "Resource Requirements",
          "type": "array"
        },
        "status": {
          "default": "pending",
          "enum": [
            "pending",
            "ready",
            "running",
            "completed",
            "failed",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        },
        "step_id": {
          "title": "Step Id",
          "type": "string"
        }
      },
      "required": [
        "step_id",
        "objective_id",
        "action_type"
      ],
      "title": "PlanStep",
      "type": "object"
    },
    "PlanStepReplacement": {
      "additionalProperties": false,
      "properties": {
        "replacement": {
          "$ref": "#/$defs/PlanStep"
        },
        "step_id": {
          "title": "Step Id",
          "type": "string"
        }
      },
      "required": [
        "step_id",
        "replacement"
      ],
      "title": "PlanStepReplacement",
      "type": "object"
    },
    "PlanStepStatusUpdate": {
      "additionalProperties": false,
      "properties": {
        "expected_status": {
          "enum": [
            "pending",
            "ready",
            "running"
          ],
          "title": "Expected Status",
          "type": "string"
        },
        "step_id": {
          "title": "Step Id",
          "type": "string"
        },
        "target_status": {
          "enum": [
            "ready",
            "running",
            "completed",
            "failed",
            "skipped"
          ],
          "title": "Target Status",
          "type": "string"
        }
      },
      "required": [
        "step_id",
        "expected_status",
        "target_status"
      ],
      "title": "PlanStepStatusUpdate",
      "type": "object"
    }
  },
  "$id": "contract://v2/PlanDelta",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "added_steps": {
      "items": {
        "$ref": "#/$defs/PlanStep"
      },
      "title": "Added Steps",
      "type": "array"
    },
    "base_revision": {
      "minimum": 0,
      "title": "Base Revision",
      "type": "integer"
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "replacements": {
      "items": {
        "$ref": "#/$defs/PlanStepReplacement"
      },
      "title": "Replacements",
      "type": "array"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status_updates": {
      "items": {
        "$ref": "#/$defs/PlanStepStatusUpdate"
      },
      "title": "Status Updates",
      "type": "array"
    }
  },
  "required": [
    "base_revision",
    "reason"
  ],
  "title": "PlanDelta",
  "type": "object"
}
